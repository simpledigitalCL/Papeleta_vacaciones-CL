<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Carta, igual que el formulario original (612x792 pt). Los margenes
        reproducen los del PDF modelo: 72 pt = 25,4 mm a los lados, 59 pt ~ 20 mm
        hasta la cabecera, y abajo el espacio donde vive el pie.

        `header_spacing` en 0 y `header_line` apagado porque el documento trae su
        propia cabecera dibujada: la de Odoo se sumaria encima.
    -->
    <record id="paperformat_papeleta_feriado" model="report.paperformat">
        <field name="name">Papeleta de Feriado Legal (Carta)</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">25</field>
        <field name="margin_right">25</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

</odoo>
