<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        `binding_model_id` es lo que pone el comprobante en el menu Imprimir de
        la solicitud y de la lista. Sirve ademas para emitir varias de una:
        seleccionar filas en «Todo el tiempo personal» y imprimir saca una hoja
        por solicitud.
    -->
    <record id="action_report_papeleta_feriado" model="ir.actions.report">
        <field name="name">Comprobante de Feriado Legal</field>
        <field name="model">hr.leave</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sd_hr_papeleta_feriado.report_papeleta_feriado</field>
        <field name="report_file">sd_hr_papeleta_feriado.report_papeleta_feriado</field>
        <field name="print_report_name">'Papeleta Feriado - %s - %s' % ((object.employee_id.name or 'sin trabajador').replace('/', '-'), object.id)</field>
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_papeleta_feriado"/>
    </record>

</odoo>
