<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        El talonario, donde la empresa lo pueda ver. Odoo esconde las secuencias
        en Ajustes / Tecnico, que exige modo desarrollador: una empresa que
        viene numerando a mano y necesita decir "vamos en la 30, la que sigue es
        la 31" no tiene por que pasar por ahi. Esta accion muestra SOLO el
        correlativo de la papeleta, y el campo a tocar es "Siguiente numero".

        Va con `groups="base.group_system"` porque escribir `ir.sequence` esta
        reservado a Ajustes en el propio Odoo (el responsable de RRHH tiene
        lectura, no escritura). Abrirlo mas exigiria dar permiso de escritura
        sobre TODAS las secuencias —las de facturas y pedidos incluidas—, que es
        mucho mas de lo que este modulo tiene derecho a repartir.
    -->
    <record id="action_secuencia_folio_papeleta" model="ir.actions.act_window">
        <field name="name">Folio de la papeleta</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('code', '=', 'sd.hr.papeleta.feriado')]</field>
        <field name="context">{'default_code': 'sd.hr.papeleta.feriado'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aca se define el numero con el que sale la proxima papeleta.
            </p>
            <p>
                Si la empresa venia llevando el talonario a mano, poner en
                <b>Siguiente numero</b> el folio que sigue al ultimo emitido.
                De ahi en adelante cada papeleta impresa toma el suyo y avanza
                sola.
            </p>
        </field>
    </record>

    <menuitem id="menu_secuencia_folio_papeleta"
              name="Folio de la papeleta"
              parent="hr_holidays.menu_hr_holidays_configuration"
              action="action_secuencia_folio_papeleta"
              groups="base.group_system"
              sequence="90"/>

</odoo>
